<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_xiaomi_gradient"
    android:fillViewport="true"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        
        <!-- Header: "健康" and Avatar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="健康"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/xm_text_title"
                android:layout_centerVertical="true" />
                
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/user"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:clipToOutline="true"/>
            
            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:layout_toLeftOf="@id/iv_avatar"
                android:layout_marginRight="16dp"
                android:layout_centerVertical="true"
                app:tint="@color/xm_text_title" />
        </RelativeLayout>
        
        <!-- Top Main Data Card (like the arc and 3 columns) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/xm_bg_bottom">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                
                <!-- Main visualization (Arc placeholder) -->
                <ProgressBar
                    android:id="@+id/progress_goal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/xm_orange"
                    android:progressBackgroundTint="#F0F0F0"
                    android:layout_marginBottom="24dp"/>
                
                <!-- 3 Columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    
                    <!-- 卡路里 -> 运动次数 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 运动次数 >"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label"
                            android:layout_marginBottom="4dp" />
                        
                        <TextView
                            android:id="@+id/tv_workout_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/xm_text_value" />
                            
                        <TextView
                            android:id="@+id/tv_goal_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/0 次"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label_light" />
                    </LinearLayout>
                    
                    <!-- 步数 -> 运动时长 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 运动时长 >"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label"
                            android:layout_marginBottom="4dp" />
                        
                        <TextView
                            android:id="@+id/tv_workout_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/xm_text_value" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="分钟"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label_light" />
                    </LinearLayout>
                    
                    <!-- 中高强度 -> 完成度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 完成度 >"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label"
                            android:layout_marginBottom="4dp" />
                        
                        <TextView
                            android:id="@+id/tv_progress_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/xm_text_value" />
                            
                        <TextView
                            android:id="@+id/tv_progress_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未设置"
                            android:textSize="12sp"
                            android:textColor="@color/xm_text_label_light" />
                    </LinearLayout>
                </LinearLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"/>
                    
                <TextView
                    android:id="@+id/tv_current_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏃 活动次数 0 次"
                    android:textSize="14sp"
                    android:textColor="@color/xm_text_title"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Grid of 2x2 cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <!-- Left Card: Goal Setting -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:id="@+id/btn_set_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_home"
                        android:background="@drawable/bg_circle_purple"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="目标设置"
                        android:textSize="16sp"
                        android:textColor="@color/xm_text_title"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击设置今日\n运动目标"
                        android:textSize="12sp"
                        android:textColor="@color/xm_text_label" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Right Card: Start/End Exercise -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_videos"
                        android:background="@drawable/bg_circle_red"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="16dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快速开始"
                        android:textSize="16sp"
                        android:textColor="@color/xm_text_title"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        
                        <Button
                            android:id="@+id/btn_start_exercise"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="开始"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:textColor="@color/white"
                            android:background="@drawable/button_primary_background"
                            app:backgroundTint="@color/xm_orange"
                            android:layout_marginRight="4dp"/>
                            
                        <Button
                            android:id="@+id/btn_end_exercise"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="结束"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:textColor="@color/xm_text_label"
                            android:background="@drawable/button_primary_background"
                            app:backgroundTint="#F0F0F0"
                            android:layout_marginLeft="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        <!-- Chart Container Card (Moved from ChartsFragment) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/xm_bg_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="@color/xm_orange"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="趋势分析"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/xm_text_title" />
                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Bottom Settings & Logout -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/xm_bg_bottom">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                
                <!-- This hides unused UI components but keeps IDs for logic -->
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="invisible">
                    <EditText android:id="@+id/et_nickname" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tv_wechat_id" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_signature" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                
                <Button
                    android:id="@+id/buttonLogout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="退出登录"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/xm_text_title"
                    android:background="@android:color/transparent"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>