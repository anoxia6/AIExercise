<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_xiaomi_gradient"
    android:fillViewport="true"
    tools:context=".VideosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        
        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运动监控"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/xm_text_title"
                android:layout_centerVertical="true" />
                
            <LinearLayout
                android:id="@+id/connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center">
                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_green"
                    android:layout_marginRight="6dp" />
                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已连接"
                    android:textSize="12sp"
                    android:textColor="@color/xm_text_title" />
            </LinearLayout>
        </RelativeLayout>
        
        <!-- Video Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">
            
            <FrameLayout
                android:id="@+id/video_container"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:background="@color/white"
                android:clipChildren="true">
                
                <com.github.niqdev.mjpeg.MjpegSurfaceView
                    android:id="@+id/mjpegView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:type="stream_default" />
                    
                <TextView
                    android:id="@+id/video_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30:25"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:layout_gravity="top|left"
                    android:layout_margin="12dp"
                    android:background="#66000000"
                    android:padding="6dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Grid of Data Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <!-- Left Card: Current Count -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_videos"
                        android:background="@drawable/bg_circle_blue"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前次数"
                        android:textSize="14sp"
                        android:textColor="@color/xm_text_label"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tv_current_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textColor="@color/xm_text_value"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Right Card: Score -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_home"
                        android:background="@drawable/bg_circle_orange"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前分数"
                        android:textSize="14sp"
                        android:textColor="@color/xm_text_label"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tv_current_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textColor="@color/xm_text_value"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        <!-- Second Grid Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <!-- Max Score -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_home"
                        android:background="@drawable/bg_circle_red"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最高分数"
                        android:textSize="14sp"
                        android:textColor="@color/xm_text_label"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tv_max_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textColor="@color/xm_text_value"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Calories (used from old workout analysis) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/xm_bg_bottom">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_charts"
                        android:background="@drawable/bg_circle_purple"
                        android:padding="6dp"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="消耗卡路里"
                        android:textSize="14sp"
                        android:textColor="@color/xm_text_label"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tv_calories_burned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textColor="@color/xm_text_value"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        <!-- Network Stats Card (compact) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/xm_bg_bottom">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FPS"
                        android:textSize="12sp"
                        android:textColor="@color/xm_text_label" />
                    <TextView
                        android:id="@+id/tv_fps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/xm_text_title" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分辨率"
                        android:textSize="12sp"
                        android:textColor="@color/xm_text_label" />
                    <TextView
                        android:id="@+id/tv_resolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1080p"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/xm_text_title" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="延迟"
                        android:textSize="12sp"
                        android:textColor="@color/xm_text_label" />
                    <TextView
                        android:id="@+id/tv_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120ms"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/xm_text_title" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Invisible Analysis Button / Text (keeping IDs for code) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="invisible">
            <Button android:id="@+id/btn_motion_analysis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_workout_count_analysis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_workout_advice" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
